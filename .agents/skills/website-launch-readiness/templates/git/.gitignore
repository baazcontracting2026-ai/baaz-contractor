# =================================================================
# Master .gitignore for Web Development Projects (Astro, Vite, Next, Node)
# =================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Artifacts
dist/
build/
out/
.astro/
.next/
.cache/
.parcel-cache/
.vite/
.rollup.cache/

# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & zips
*.zip
*.tar.gz
*.rar
tmp/
temp/
