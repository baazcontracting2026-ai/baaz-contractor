---
// src/pages/404.astro
// Production-ready 404 Page Not Found Template
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - Page Not Found | We Couldn't Find That Page</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full bg-slate-950 text-slate-100 flex flex-col justify-between selection:bg-indigo-500 selection:text-white font-sans antialiased">
  
  <!-- Minimal Navigation -->
  <header class="w-full max-w-7xl mx-auto px-6 py-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-white hover:opacity-80 transition">
      <span class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-sm font-black">★</span>
      <span>Company Name</span>
    </a>
    <a href="/contact" class="text-sm font-medium text-slate-400 hover:text-white transition">Need Help? Contact Us &rarr;</a>
  </header>

  <!-- Main Error Section -->
  <main class="flex-1 flex items-center justify-center px-6 py-12">
    <div class="max-w-2xl mx-auto text-center">
      
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6">
        <span>Error 404</span>
        <span class="w-1 h-1 rounded-full bg-indigo-400"></span>
        <span>Page Missing</span>
      </div>

      <!-- Heading -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-4">
        Oops! You've reached a dead end.
      </h1>
      <p class="text-lg sm:text-xl text-slate-400 mb-8 max-w-lg mx-auto leading-relaxed">
        The link you followed may be broken, expired, or mistyped. Let's get you back on track.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a
          href="/"
          class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/25 transition-all duration-200 transform hover:-translate-y-0.5 flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return to Homepage
        </a>
        <button
          onclick="history.back()"
          class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 font-semibold transition-all duration-200"
        >
          Go Back Previous Page
        </button>
      </div>

      <!-- Quick Helpful Navigation Links -->
      <div class="pt-8 border-t border-slate-800/80">
        <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-4">
          Popular Destinations
        </p>
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/#services" class="text-slate-400 hover:text-indigo-400 transition">Services / Classes</a>
          <a href="/#faq" class="text-slate-400 hover:text-indigo-400 transition">FAQs</a>
          <a href="/about" class="text-slate-400 hover:text-indigo-400 transition">About Us</a>
          <a href="/contact" class="text-slate-400 hover:text-indigo-400 transition">Contact Support</a>
        </div>
      </div>

    </div>
  </main>

  <!-- Minimal Footer -->
  <footer class="w-full max-w-7xl mx-auto px-6 py-6 text-center text-xs text-slate-600">
    <p>&copy; {new Date().getFullYear()} Company Name. All rights reserved.</p>
  </footer>

</body>
</html>
