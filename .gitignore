# =================================================================
# Master .gitignore for Baaz Contracting
# =================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Artifacts
dist/
build/
out/
.astro/
.next/
.cache/
.vite/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & IDE Configs
.vscode/*
!.vscode/settings.json
.idea/

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Temporary files & zips
*.zip
*.tar.gz
tmp/
temp/
